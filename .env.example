# Skopiuj ten plik:  cp .env.example .env.local   i wklej wartości od integratora.
# Skąd je wziąć: docs/team/setup.md, krok "Supabase". Plik .env.local NIGDY nie trafia do gita.

# Supabase -> Project Settings -> Data API -> Project URL (https://<id>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase -> Project Settings -> API Keys -> Publishable key (zaczyna się od sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# server/scripts only; never NEXT_PUBLIC
SUPABASE_SECRET_KEY=
# Exact public origin for bearer-only MCP/guard routes (for local demo: http://localhost:3000).
INTERLOCK_PUBLIC_ORIGIN=
# Operator-only token issuance command; an existing active admin actor UUID.
INTERLOCK_OPERATOR_ACTOR_ID=
DEMO_ADMIN_PASSWORD=
DEMO_ANALYST_PASSWORD=
DEMO_EMPLOYEE_PASSWORD=
DEMO_REVIEWER_PASSWORD=
